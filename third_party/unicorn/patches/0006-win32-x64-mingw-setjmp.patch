Subject: os-win32: non-unwinding setjmp/longjmp on x64 mingw

Part of h9 (third_party/unicorn). Modifies Unicorn, so GPLv2 like it.

--- a/qemu/include/sysemu/os-win32.h
+++ b/qemu/include/sysemu/os-win32.h
@@ -44,6 +44,18 @@
 #define setjmp(env) __mingw_setjmp(env)
 #define longjmp(env, val) __mingw_longjmp(env, val)
 
+#elif defined(__MINGW32__) && defined(__x86_64__)
+/* With UCRT, x64 longjmp unwinds with RtlUnwindEx even after
+ * _setjmp(env, NULL), and fails with STATUS_BAD_STACK (0xC00000FF) when
+ * generated code is on the stack. mingw-w64 has no __mingw_longjmp for x64,
+ * so qemu/util/setjmp-win64-mingw.S restores registers without unwinding. */
+int qemu_win64_setjmp(jmp_buf env) __attribute__((returns_twice));
+__attribute__((noreturn)) void qemu_win64_longjmp(jmp_buf env, int val);
+#undef setjmp
+#undef longjmp
+#define setjmp(env) qemu_win64_setjmp(env)
+#define longjmp(env, val) qemu_win64_longjmp(env, val)
+
 #elif defined(_WIN64)
 /* On w64, setjmp is implemented by _setjmp which needs a second parameter.
  * If this parameter is NULL, longjump does no stack unwinding.
--- a/qemu/util/setjmp-win64-mingw.S	1969-12-31 19:00:00
+++ b/qemu/util/setjmp-win64-mingw.S	2026-11-05 18:51:40
@@ -0,0 +1,70 @@
+/*
+ * Non-unwinding setjmp/longjmp for x64 Windows with mingw-w64 (see
+ * os-win32.h). Saves the callee-saved registers of the Windows x64 ABI,
+ * the stack pointer, the return address, MXCSR and the x87 control word.
+ * jmp_buf is 256 bytes; this uses 246 of them.
+ */
+	.text
+
+	.globl	qemu_win64_setjmp
+	.def	qemu_win64_setjmp; .scl 2; .type 32; .endef
+	.p2align 4
+qemu_win64_setjmp:
+	movq	%rbx, 0(%rcx)
+	movq	%rbp, 8(%rcx)
+	movq	%rdi, 16(%rcx)
+	movq	%rsi, 24(%rcx)
+	movq	%r12, 32(%rcx)
+	movq	%r13, 40(%rcx)
+	movq	%r14, 48(%rcx)
+	movq	%r15, 56(%rcx)
+	leaq	8(%rsp), %rdx
+	movq	%rdx, 64(%rcx)
+	movq	(%rsp), %rdx
+	movq	%rdx, 72(%rcx)
+	movdqu	%xmm6, 80(%rcx)
+	movdqu	%xmm7, 96(%rcx)
+	movdqu	%xmm8, 112(%rcx)
+	movdqu	%xmm9, 128(%rcx)
+	movdqu	%xmm10, 144(%rcx)
+	movdqu	%xmm11, 160(%rcx)
+	movdqu	%xmm12, 176(%rcx)
+	movdqu	%xmm13, 192(%rcx)
+	movdqu	%xmm14, 208(%rcx)
+	movdqu	%xmm15, 224(%rcx)
+	stmxcsr	240(%rcx)
+	fnstcw	244(%rcx)
+	xorl	%eax, %eax
+	ret
+
+	.globl	qemu_win64_longjmp
+	.def	qemu_win64_longjmp; .scl 2; .type 32; .endef
+	.p2align 4
+qemu_win64_longjmp:
+	movl	%edx, %eax
+	testl	%eax, %eax
+	jnz	1f
+	incl	%eax
+1:
+	movq	0(%rcx), %rbx
+	movq	8(%rcx), %rbp
+	movq	16(%rcx), %rdi
+	movq	24(%rcx), %rsi
+	movq	32(%rcx), %r12
+	movq	40(%rcx), %r13
+	movq	48(%rcx), %r14
+	movq	56(%rcx), %r15
+	movdqu	80(%rcx), %xmm6
+	movdqu	96(%rcx), %xmm7
+	movdqu	112(%rcx), %xmm8
+	movdqu	128(%rcx), %xmm9
+	movdqu	144(%rcx), %xmm10
+	movdqu	160(%rcx), %xmm11
+	movdqu	176(%rcx), %xmm12
+	movdqu	192(%rcx), %xmm13
+	movdqu	208(%rcx), %xmm14
+	movdqu	224(%rcx), %xmm15
+	ldmxcsr	240(%rcx)
+	fldcw	244(%rcx)
+	movq	64(%rcx), %rsp
+	jmpq	*72(%rcx)
