Subject: translate-all: vectored code buffer handler without a trampoline on arm64 Windows

Part of hp9 (third_party/unicorn). Modifies Unicorn, so GPLv2 like it.

diff --git a/qemu/accel/tcg/translate-all.c b/qemu/accel/tcg/translate-all.c
index 71b6b2b..d508dcd 100644
--- a/qemu/accel/tcg/translate-all.c
+++ b/qemu/accel/tcg/translate-all.c
@@ -900,6 +900,78 @@ static LONG __fastcall code_gen_buffer_handler(PEXCEPTION_POINTERS ptr, struct u
     return EXCEPTION_CONTINUE_SEARCH;
 }
 
+#if defined(__aarch64__)
+/*
+ * arm64: a vectored handler only gets the exception pointers, and there's no
+ * x86 trampoline to bind uc to it, so live code buffers are kept in a list
+ * and the handler looks the faulting address up in it.
+ */
+static SRWLOCK seh_lock = SRWLOCK_INIT;
+static struct uc_struct *seh_ucs[64];
+
+static LONG CALLBACK code_gen_buffer_handler_arm64(PEXCEPTION_POINTERS ptr)
+{
+    LONG r = EXCEPTION_CONTINUE_SEARCH;
+    int i;
+
+    AcquireSRWLockShared(&seh_lock);
+    for (i = 0; i < ARRAY_SIZE(seh_ucs) && r == EXCEPTION_CONTINUE_SEARCH; i++) {
+        if (seh_ucs[i]) {
+            r = code_gen_buffer_handler(ptr, seh_ucs[i]);
+        }
+    }
+    ReleaseSRWLockShared(&seh_lock);
+    return r;
+}
+
+static inline void may_remove_handler(struct uc_struct *uc)
+{
+    int i;
+
+    AcquireSRWLockExclusive(&seh_lock);
+    for (i = 0; i < ARRAY_SIZE(seh_ucs); i++) {
+        if (seh_ucs[i] == uc) {
+            seh_ucs[i] = NULL;
+        }
+    }
+    ReleaseSRWLockExclusive(&seh_lock);
+    if (uc->seh_handle) {
+        RemoveVectoredExceptionHandler(uc->seh_handle);
+        uc->seh_handle = NULL;
+    }
+}
+
+static inline void *alloc_code_gen_buffer(struct uc_struct *uc)
+{
+    TCGContext *tcg_ctx = uc->tcg_ctx;
+    size_t size = tcg_ctx->code_gen_buffer_size;
+    int i;
+
+    may_remove_handler(uc);
+
+    AcquireSRWLockExclusive(&seh_lock);
+    for (i = 0; i < ARRAY_SIZE(seh_ucs) && seh_ucs[i]; i++) {
+    }
+    if (i < ARRAY_SIZE(seh_ucs)) {
+        seh_ucs[i] = uc;
+    }
+    ReleaseSRWLockExclusive(&seh_lock);
+    if (i == ARRAY_SIZE(seh_ucs)) {
+        return NULL;
+    }
+
+    /* First in the chain: it only claims faults in a code buffer, and a
+     * handler installed earlier (Zig's segfault handler, say) would
+     * otherwise treat the on-demand commit fault as a crash. */
+    uc->seh_handle = AddVectoredExceptionHandler(1, code_gen_buffer_handler_arm64);
+    if (!uc->seh_handle) {
+        may_remove_handler(uc);
+        return NULL;
+    }
+
+    return VirtualAlloc(NULL, size, MEM_RESERVE, PAGE_EXECUTE_READWRITE);
+}
+#else
 static inline void may_remove_handler(struct uc_struct *uc) {
     if (uc->seh_closure) {
         if (uc->seh_handle) {
@@ -997,6 +1069,7 @@ static inline void *alloc_code_gen_buffer(struct uc_struct *uc)
 
     return VirtualAlloc(NULL, size, MEM_RESERVE, PAGE_EXECUTE_READWRITE);
 }
+#endif
 void free_code_gen_buffer(struct uc_struct *uc)
 {
     TCGContext *tcg_ctx = uc->tcg_ctx;
