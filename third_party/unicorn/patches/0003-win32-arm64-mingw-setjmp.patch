Subject: os-win32: non-unwinding setjmp/longjmp on arm64 mingw

Part of h9 (third_party/unicorn). Modifies Unicorn, so GPLv2 like it.

diff --git a/qemu/include/sysemu/os-win32.h b/qemu/include/sysemu/os-win32.h
index d77d0fb..fa4cb66 100644
--- a/qemu/include/sysemu/os-win32.h
+++ b/qemu/include/sysemu/os-win32.h
@@ -31,7 +31,20 @@
 #include <winnt.h> // For vectorized handler
 #include <ws2tcpip.h>
 
-#if defined(_WIN64)
+#if defined(__MINGW32__) && defined(__aarch64__)
+/* On arm64 Windows, longjmp always unwinds the stack with RtlUnwindEx,
+ * which fails with STATUS_BAD_STACK (0xC00000FF) when generated code is on
+ * it, and there's no second setjmp argument to turn that off as on x64.
+ * mingw-w64's __mingw_setjmp/__mingw_longjmp save and restore the
+ * callee-saved registers directly, without unwinding. */
+int __mingw_setjmp(jmp_buf env);
+__attribute__((noreturn)) void __mingw_longjmp(jmp_buf env, int val);
+#undef setjmp
+#undef longjmp
+#define setjmp(env) __mingw_setjmp(env)
+#define longjmp(env, val) __mingw_longjmp(env, val)
+
+#elif defined(_WIN64)
 /* On w64, setjmp is implemented by _setjmp which needs a second parameter.
  * If this parameter is NULL, longjump does no stack unwinding.
  * That is what we need for QEMU. Passing the value of register rsp (default)
